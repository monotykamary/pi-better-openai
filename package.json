{
  "name": "@monotykamary/pi-better-openai",
  "version": "0.2.14",
  "description": "Improve OpenAI in pi with fast mode, usage stats, realtime voice, image generation, and footer polish.",
  "keywords": [
    "fast",
    "gpt",
    "image",
    "openai",
    "pi",
    "pi-extension",
    "pi-package",
    "priority",
    "service-tier",
    "voice",
    "webrtc"
  ],
  "homepage": "https://github.com/monotykamary/pi-better-openai#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-better-openai/issues"
  },
  "license": "MIT",
  "author": "monotykamary",
  "contributors": [
    {
      "name": "Matt Leong",
      "url": "https://github.com/mattleong"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-better-openai.git"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "plans/devday-integration.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings index.ts src/*.ts src/*/*.ts src/*/*/*.ts src/*/*/*.mjs tests/*.ts",
    "lint:fix": "oxlint --fix index.ts src/*.ts src/*/*.ts src/*/*/*.ts src/*/*/*.mjs tests/*.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:pi": "node scripts/test-pi-compat.mjs"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "jiti": "2.7.0",
    "proxy-from-env": "2.1.0",
    "sharp": "0.35.5",
    "undici": "8.10.2",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "~22.19.0",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-darwin-arm64": "17.2.9",
    "@oh-my-pi/pi-natives-darwin-x64": "17.2.9",
    "@oh-my-pi/pi-natives-linux-arm64": "17.2.9",
    "@oh-my-pi/pi-natives-linux-x64": "17.2.9",
    "@oh-my-pi/pi-natives-win32-x64": "17.2.9"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "undici": "8.10.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
