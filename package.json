{
  "name": "@monotykamary/pi-better-openai",
  "version": "0.1.33",
  "description": "Improve OpenAI in pi with fast mode, usage stats, realtime voice, image generation, and footer polish.",
  "keywords": [
    "fast",
    "gpt",
    "image",
    "openai",
    "pi",
    "pi-extension",
    "pi-package",
    "priority",
    "service-tier",
    "voice",
    "webrtc"
  ],
  "homepage": "https://github.com/monotykamary/pi-better-openai#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-better-openai/issues"
  },
  "license": "MIT",
  "author": "monotykamary",
  "contributors": [
    {
      "name": "Matt Leong",
      "url": "https://github.com/mattleong"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-better-openai.git"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings index.ts src/*.ts src/*/*.ts tests/*.ts",
    "lint:fix": "oxlint --fix index.ts src/*.ts src/*/*.ts tests/*.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "proxy-from-env": "2.1.0",
    "sharp": "0.35.3",
    "undici": "8.10.0",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "~22.19.0",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-darwin-arm64": "17.2.9",
    "@oh-my-pi/pi-natives-darwin-x64": "17.2.9",
    "@oh-my-pi/pi-natives-linux-arm64": "17.2.9",
    "@oh-my-pi/pi-natives-linux-x64": "17.2.9",
    "@oh-my-pi/pi-natives-win32-x64": "17.2.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.20.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
